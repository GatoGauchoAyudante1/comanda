# Nombre del sistema. Es la marca del producto, no la del cliente: aparece en
# el login, los titulos y el icono de la app. El nombre del cliente se define
# mas abajo en NEGOCIO_NOMBRE y sale en el ticket (ver docs/02-decisiones.md, D-02).
APP_NAME=Comandas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# --- Configuracion del negocio (ver docs/02-decisiones.md, D-02 y D-04) ---
# Nada del cliente se hardcodea en el codigo: todo se define aca.
# Sin acentos a proposito: los .env se editan con herramientas que a veces
# rompen la codificacion (D-14).
#
# El nombre sale en el encabezado del ticket.
NEGOCIO_NOMBRE="Mi negocio"
#
# Los modulos son lo CONTRATADO: es el techo de lo que el cliente puede usar.
# Desde Ajustes -> Modulos el dueno prende o apaga los que estan en true; los
# que estan en false le aparecen "Bloqueado" y no los puede activar.
# Para habilitarle uno: ponerlo en true aca y correr `php artisan config:cache`.
#
# Si se omite una clave, vale el valor por defecto que esta al lado.
NEGOCIO_MODULO_SALON=true              # por defecto true.  Mesas comunes con consumo
NEGOCIO_MODULO_POOL=false              # por defecto false. Mesas de pool cobradas por tiempo
NEGOCIO_MODULO_DELIVERY=false          # por defecto false. Pedidos, tablero, repartidores
NEGOCIO_MODULO_STOCK=true              # por defecto true.  Insumos, recetas y conteo
# Carta con carrito para que el cliente pida desde su celular. NECESITA
# NEGOCIO_MODULO_DELIVERY=true: el pedido confirmado entra a ese tablero.
NEGOCIO_MODULO_PEDIDOS_ONLINE=false    # por defecto false.

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Clave del panel del desarrollador (/dev-panel), el control del abono mensual
# del sistema. Va sólo acá, nunca en la base: un admin del cliente no la cambia.
# Vacía deshabilita el panel (responde 403).
DEV_PANEL_KEY=
